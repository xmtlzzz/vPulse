{
  "name": "vpulse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --local --ip 127.0.0.1 --port 5175 --inspector-port 0",
    "deploy": "npm run check && npm run d1:migrate:remote && wrangler deploy",
    "d1:init": "wrangler d1 execute vpulse-db --local --file=schema.sql && npm run d1:migrate",
    "d1:init:remote": "wrangler d1 execute vpulse-db --remote --file=schema.sql && npm run d1:migrate:remote",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm test && npm run build",
    "d1:migrate": "wrangler d1 migrations apply vpulse-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply vpulse-db --remote",
    "types": "wrangler types worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false --strict-vars false"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
